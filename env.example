# vSphere MCP Server Configuration
# Copia questo file come .env e configura i valori appropriati

# vCenter Configuration
VCENTER_HOST=vcenter.domain.local
VCENTER_USER=username@domain.local
VCENTER_PASSWORD=your_password_here

# SSL Configuration (True = disable SSL verification, False = enable SSL verification)
# In ambienti enterprise è comune disabilitare la verifica SSL
INSECURE=True

# MCP Server Authentication (optional, leave empty to disable auth)
MCP_AUTH_TOKEN=

# Tools to hide from MCP clients (optional, comma-separated tool names).
# Read-only example:
# DISABLED_TOOLS=power_on_vm,power_off_vm,force_power_off_vm,bulk_power_operations,create_vm_snapshot,delete_vm_snapshot,revert_vm_snapshot,delete_vm,bulk_delete_vms,modify_vm_resources,clone_vm
DISABLED_TOOLS=
